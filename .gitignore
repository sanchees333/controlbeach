# ==========================================
# RESENHA BEACH — .gitignore
# ==========================================

# Dependencias Node.js (reinstale com: npm install)
node_modules/

# Banco de dados SQLite (dados reais do cliente)
data/
*.db
*.db-shm
*.db-wal

# Logs
*.log
npm-debug.log*
nodemon-debug.log*

# Variaveis de ambiente
.env
.env.local
.env.production

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Build / temporarios
dist/
tmp/
